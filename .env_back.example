MODE=DOCKER

POSTGRES_DB=cert_admin
POSTGRES_HOST=localhost
POSTGRES_HOST_DOCKER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_HOST_DOCKER=redis
REDIS_PORT=6379

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600

# Логирование. Handler'ы: console, file, db_logger (таблица logs) — можно несколько через запятую
LOG_LEVEL=INFO
LOG_HANDLERS=console
# Переопределение по типу лога (имя логгера app.<тип>): auth — вход/выход, tasks — задачи
# LOG_ROUTES={"auth": "db_logger", "tasks": "db_logger,file"}
LOG_FILE=logs/app.log