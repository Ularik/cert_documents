MODE=DOCKER

# SSR ходит к бэкенду по имени сервиса compose (MODE=DOCKER/PROD) или на хост (MODE=LOCAL).
# Браузер всегда использует относительный /api через nginx.
NEXT_BACK_URL=http://backend:8000
NEXT_BACK_URL_LOCAL=http://localhost:8001

# Только для `npm run dev` без nginx (скопируйте файл в cert_admin_front/dashboard/.env):
# NEXT_PUBLIC_API_URL=http://localhost:8001/api
